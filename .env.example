# Dead Side — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NEVER be committed.
#
# All client-side variables MUST be prefixed with NEXT_PUBLIC_
# (Next.js strips any variable without this prefix from the client bundle)

# ─── Site URL (used for canonical / OG URLs, sitemap, RSS) ───
# NEXT_PUBLIC_SITE_URL=https://deadside.vercel.app

# ─── Analytics ─────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=
